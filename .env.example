# ============ 必填 ============
PIXIV_REFRESH_TOKEN=your_refresh_token_here
TARGET_USER_ID=12345678

# access_token 后台刷新间隔（分钟，1-59）
TOKEN_REFRESH_INTERVAL=50

# ============ 存储：local / webdav ============
STORAGE_BACKEND=local
DOWNLOAD_PATH=/app/data/downloads
DB_PATH=/app/data/pixiv_downloader.db

# 使用 WebDAV 时填写；也可在 WebUI「配置」页修改
# WEBDAV_URL=https://dav.jianguoyun.com/dav
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
WEBDAV_ROOT=pixiv
WEBDAV_VERIFY_SSL=true
# 上传后等待文件可见的最长时间（秒）；0 表示不校验
WEBDAV_VERIFY_TIMEOUT=60

# 原图获取方式：proxy=WebUI 转发 / redirect=302 到 WebDAV 直链
IMAGE_DELIVERY=proxy
WEBDAV_PUBLIC_URL=

# ============ 请求节流 ============
# API 请求基础间隔 + 随机抖动（秒）
REQUEST_DELAY=3.0
REQUEST_JITTER=1.0
# 同一作品多页之间的下载间隔
DOWNLOAD_DELAY=1.5
MAX_RETRIES=3
RATE_LIMIT_WAIT=180
# 每处理 N 位画师强制冷却一次；0 表示关闭
ARTIST_COOLDOWN_EVERY=15
ARTIST_COOLDOWN_SECONDS=120

# 调度（cron / 固定间隔 / 手动）在 WebUI「下载规则」页设置

# ============ 网络 ============
# HTTPS_PROXY=http://127.0.0.1:7890

# ============ WebUI ============
WEBUI_HOST=0.0.0.0
WEBUI_PORT=8971
# 用户名留空则无需登录；公网部署请务必设置
WEBUI_USERNAME=
WEBUI_PASSWORD=
